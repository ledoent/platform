{
  "name": "anticrm",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "validate": "turbo run validate",
    "format": "turbo run format",
    "lint": "turbo run lint",
    "install-all": "pnpm install",
    "check": "node common/scripts/check-versions.js",
