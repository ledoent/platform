    "docker:up": "cd ./dev && docker compose up -d --force-recreate",
    "docker:push": "turbo run docker:push"
  },
  "devDependencies": {
    "turbo": "^2.0.0"
  },
  "packageManager": "pnpm@10.15.1"
}
